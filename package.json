{
  "name": "attendance-tracker",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "deploy": "npm run test && npm run db:migrate:remote && npm run build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply attendance-tracker --local",
    "db:migrate:remote": "wrangler d1 migrations apply attendance-tracker --remote",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.7.2",
    "hono": "^4.9.2",
    "korean-holidays": "^1.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.12.0",
    "@cloudflare/workers-types": "^5.20260728.1",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.31.0"
  }
}
